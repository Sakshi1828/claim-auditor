# Copy this file to .env and fill in YOUR keys. .env is git-ignored: never commit it or paste keys anywhere else.
# The tool works without any key (rule-based engine only); keys only enable the optional LLM layer.

# Which provider to try first, and which to use if it fails (gemini | groq | none)
LLM_PROVIDER=gemini
LLM_FALLBACK=groq

# Keys (placeholders: replace them)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Models
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Behaviour
LLM_TIMEOUT=90           # seconds per request (long structured answers need time)
LLM_MAX_RETRIES=3        # per provider, with exponential backoff; HTTP 429 honours Retry-After
LLM_MIN_INTERVAL=0.5     # minimum seconds between requests to one provider
LLM_CACHE=1              # cache validated answers in outputs/.llm_cache (no keys stored)
# GEMINI_THINKING_BUDGET=0      # optional: 0 = faster/cheaper, unset = model default
# GROQ_REASONING_EFFORT=low     # optional: low | medium | high
# SEMANTIC_BATCH=25      # sentences per request (default 25 for Gemini, 10 for Groq)
# GROQ_MAX_TOKENS=32768  # output limit per Groq request (reasoning counts towards it)
